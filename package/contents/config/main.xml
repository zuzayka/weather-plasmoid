<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="fontSize" type="Int">
      <default>16</default>
    </entry>
    <entry name="textColor" type="String">
      <default>#ffffff</default>
    </entry>
    <entry name="bgOpacity" type="Double">
      <default>0.45</default>
    </entry>
    <entry name="bgColor" type="String">
      <default>#000000</default>
    </entry>
    <entry name="showWind" type="Bool">
      <default>true</default>
    </entry>
    <entry name="cardStyle" type="String">
      <default>rounded</default>
    </entry>
    <entry name="language" type="String">
      <default>ru</default>
    </entry>
    <entry name="cityName" type="String">
      <default></default>
    </entry>
    <entry name="latitude" type="Double">
      <default>0.0</default>
    </entry>
    <entry name="longitude" type="Double">
      <default>0.0</default>
    </entry>
    <entry name="useFahrenheit" type="Bool">
      <default>false</default>
    </entry>
    <entry name="windUnit" type="String">
      <default>м/с</default>
    </entry>
  </group>
</kcfg>